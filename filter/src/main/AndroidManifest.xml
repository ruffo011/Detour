<?xml version="1.0" encoding="utf-8"?>
<!--
  filter: the browser-only DNS filter. It needs INTERNET to forward allowed DNS lookups, which
  is exactly why it is a separate app from guard. It never receives usage data, check-ins, or
  anything personal: only the domain blocklist. The VPN service arrives in milestone 4.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DetourFilter">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
