<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform DayNight theme (API 29+); Compose draws everything inside it. -->
    <style name="Theme.Detour" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- See-through window with a dimmed background, for the small check-in card. -->
    <style name="Theme.Detour.Translucent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
